{
  "name": "flauxil-gichi-menu",
  "version": "2.0.0",
  "description": "Menú digital para Enchiladas y Flautas Flauxil & Cafetería Gichi",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview --port 8001",
    "build": "vite build",
    "lint": "eslint 'assets/**/*.js' 'menu/**/*.js' 'cafeteria/**/*.js' 'tests/**/*.js'",
    "format": "prettier --write 'assets/**/*.js' 'menu/**/*.js' 'cafeteria/**/*.js' 'assets/**/*.css' '*.js' '*.json' '*.html'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Alexis Guzman",
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "vite": "^8.1.2",
    "vitest": "^4.1.9"
  }
}
